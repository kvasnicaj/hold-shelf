{
  "name": "hold-shelf",
  "license": "MIT",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "predev": "pnpm --filter @hold-shelf/api-contracts build",
    "dev": "vite dev --port 3000",
    "build": "pnpm --filter @hold-shelf/api-contracts build && pnpm run build:web && pnpm --filter @hold-shelf/cli build",
    "build:web": "vite build",
    "preview": "vite preview",
    "test": "pnpm --filter @hold-shelf/api-contracts build && pnpm run test:web && pnpm --filter @hold-shelf/api-contracts test && pnpm --filter @hold-shelf/cli test",
    "test:web": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "pnpm --filter @hold-shelf/api-contracts build && pnpm run typecheck:web && pnpm --filter @hold-shelf/api-contracts typecheck && pnpm --filter @hold-shelf/cli typecheck",
    "typecheck:web": "tsc --noEmit",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "brand:generate": "node scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@hold-shelf/api-contracts": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@sentry/cloudflare": "11.9.0",
    "@sentry/react": "11.9.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-table": "9.3.1",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "hast-util-to-text": "^4.0.2",
    "html-react-parser": "^6.1.9",
    "nanoid": "6.0.2",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "unified": "^11.0.5",
    "vanilla-cookieconsent": "3.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@biomejs/biome": "2.6.2",
    "@cloudflare/vite-plugin": "1.65.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query-devtools": "5.104.5",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-plugin": "1.168.48",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/babel__core": "^7.20.5",
    "@types/hast": "^3.0.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "18.0.9",
    "drizzle-kit": "0.31.11",
    "jsdom": "30.1.3",
    "miniflare": "5.20261019.2-beta",
    "sharp": "0.34.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=12.15.0"
  }
}
