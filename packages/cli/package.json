{
	"name": "@hold-shelf/cli",
	"license": "MIT",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"bin": {
		"hold-shelf": "./dist/bin.js",
		"hs": "./dist/bin.js"
	},
	"engines": {
		"node": ">=24.22.1"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"prebuild": "pnpm --filter @hold-shelf/api-contracts build",
		"build": "esbuild src/bin.ts src/index.ts --bundle --packages=external --platform=node --target=node24 --format=esm --outdir=dist",
		"postbuild": "node scripts/smoke-built.mjs",
		"pretest": "pnpm --filter @hold-shelf/api-contracts build",
		"test": "vitest run",
		"pretypecheck": "pnpm --filter @hold-shelf/api-contracts build",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@hold-shelf/api-contracts": "workspace:*",
		"@inquirer/prompts": "8.7.4",
		"commander": "15.0.0"
	},
	"optionalDependencies": {
		"@napi-rs/keyring": "2.1.2"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"esbuild": "0.28.2",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	}
}
